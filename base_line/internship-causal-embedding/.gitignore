# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Data caches: small datasets are committed for offline use; the very large
# ones are excluded and re-downloaded on demand via `followup-data download`.
.cache/

# InfoQuest is ~13 GB raw and ~11 GB even as a pair-only export — too large
# for git. Run `followup-data download infoquest` locally to fetch it.
data/infoquest/

# Workflow pair files are ~1.9 GB (train_pairs.jsonl alone is 1.6 GB) and
# individual files exceed GitHub's 100 MB hard limit. Keep on disk only.
data/workflow/
data_6/workflow/

# Embedded git repos and runtime caches inside cloned dataset folders.
**/.git/
**/__pycache__/
**/*.pyc
**/.DS_Store
data/clarq_llm/ClarQ-LLM/log/
data/clarq_llm/ClarQ-LLM/results/

# Embedding caches (can be several GB; re-generated on demand)
evaluation_6/emb_cache/

# my_work/ — research checkpoints (each is 400 MB – 1.3 GB) exceed GitHub's
# 100 MB hard limit. Source code, configs, logs and small artifacts are
# tracked; *.pt weights and copied raw data are not.
my_work/**/*.pt
my_work/**/aep_causal/train.jsonl
my_work/**/aep_causal/val.jsonl
my_work/**/aep_causal/test.jsonl

# OS
.DS_Store
