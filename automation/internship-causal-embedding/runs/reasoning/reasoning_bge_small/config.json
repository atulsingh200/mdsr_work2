{
  "base_model": "BAAI/bge-small-en-v1.5",
  "data_dir": "data/reasoning_data",
  "run_name": "reasoning_bge_small",
  "architecture": "ReasoningClassifier",
  "lr_encoder": 2e-05,
  "lr_head": 0.001,
  "batch_size": 32,
  "eval_batch_size": 64,
  "epochs": 5,
  "warmup_frac": 0.1,
  "weight_decay": 0.01,
  "grad_clip": 1.0,
  "seed": 42,
  "max_seq_len": 512,
  "device": "cuda",
  "bf16": true,
  "n_train": 110699,
  "n_val": 6004,
  "n_test": 6004,
  "pool": "cls",
  "l2_normalize": true,
  "concat_form": "[A; B; A-B; A*B]",
  "head_cfg": {
    "head_type": "mlp",
    "hidden_dims": [
      512,
      128
    ],
    "dropout": 0.1,
    "activation": "gelu",
    "norm": "layer"
  },
  "freeze_encoders": false,
  "reason_weight": 1.0,
  "reason_loss": "CosineEmbeddingLoss"
}